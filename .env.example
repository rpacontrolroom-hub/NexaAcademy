# Supabase
VITE_SUPABASE_URL=https://<projeto>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key>
# Nunca coloque a service_role key aqui nem em variaveis VITE_ (vao para o navegador).

# Opcional: preenche a tela de login em desenvolvimento (bun run dev). Nunca use em producao.
VITE_DEV_LOGIN_EMAIL=
VITE_DEV_LOGIN_PASSWORD=
